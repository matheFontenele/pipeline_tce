# Copie para .env local e gere valores aleatórios. Nunca commite o .env.
# A tag observada no Airflow antigo é apenas referência de desenvolvimento;
# valide compatibilidade e suporte no destino antes de produção.
AIRFLOW_IMAGE=apache/airflow:2.10.4-python3.10
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
AIRFLOW_WEBSERVER_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@example.invalid
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD
AIRFLOW_WEBSERVER_BIND=127.0.0.1
AIRFLOW_WEBSERVER_PORT=8085
AIRFLOW_TIMEZONE=America/Fortaleza
