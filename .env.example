# Copie para .env local e gere valores aleatórios. Nunca commite o .env.
# A tag observada no Airflow antigo é apenas referência de desenvolvimento;
# valide compatibilidade e suporte no destino antes de produção.
AIRFLOW_IMAGE=apache/airflow:2.10.4-python3.10
AIRFLOW_VERSION=2.10.4
AIRFLOW_PYTHON_VERSION=3.10
AIRFLOW_RUNTIME_IMAGE=pipeline-tce-airflow:dev
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
AIRFLOW_WEBSERVER_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@example.invalid
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD
AIRFLOW_WEBSERVER_BIND=127.0.0.1
AIRFLOW_WEBSERVER_PORT=8085
AIRFLOW_TIMEZONE=America/Fortaleza

# Piloto manual, serial e sem publicar dados. O volume é exclusivo de teste.
TCE_CATALOG_DIR=/opt/airflow/catalog
TCE_PILOT_DATA_DIR=/opt/airflow/pilot-data
TCE_API_MIN_INTERVAL_SECONDS=1.5
TCE_PILOT_MAX_DISK_USAGE=0.90
TCE_HTTP_TIMEOUT=90
TCE_HTTP_MAX_ATTEMPTS=5
TCE_HTTP_400_RETRIES=3
TCE_HTTP_400_BACKOFF_SECONDS=60
TCE_HTTP_429_BACKOFF_SECONDS=30
TCE_HTTP_CONNECTION_BACKOFF_SECONDS=15
TCE_HTTP_MAX_BACKOFF_SECONDS=300
TCE_HTTP_MAX_RETRY_AFTER_SECONDS=900
TCE_API_POOL_SLOTS=1
